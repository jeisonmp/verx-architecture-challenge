# Maven Wrapper — baixa a distribuição Apache Maven (se ainda não estiver em
# cache) e executa o mvn repassando todos os argumentos.
#
# A URL da distribuição pode ser sobrescrita opcionalmente em
# .mvn/wrapper/maven-wrapper.properties (chave `distributionUrl`).

set -eu

# --- resolve o diretório base do script (segue symlinks) ---------------------
PRG="$0"
while [ -h "$PRG" ]; do
  link=$(ls -ld "$PRG" | sed 's/.* -> //')
  case "$link" in
    /*) PRG="$link" ;;
    *)  PRG="$(dirname "$PRG")/$link" ;;
  esac
done
BASE_DIR=$(CDPATH= cd -P "$(dirname "$PRG")" >/dev/null 2>&1 && pwd)

DISTRIBUTION_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.9/apache-maven-3.9.9-bin.zip"
PROPS="$BASE_DIR/.mvn/wrapper/maven-wrapper.properties"
if [ -f "$PROPS" ]; then
  override=$(sed -n 's/^[[:space:]]*distributionUrl[[:space:]]*=[[:space:]]*//p' "$PROPS" | tail -n1)
  [ -n "$override" ] && DISTRIBUTION_URL="$override"
fi

MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"
DIST_BASE="$MAVEN_USER_HOME/wrapper/dists"
ZIP_NAME=$(basename "$DISTRIBUTION_URL")
DIST_DIR="$DIST_BASE/${ZIP_NAME%.zip}"
MAVEN_HOME="$DIST_DIR/$(ls "$DIST_DIR" 2>/dev/null | head -n1)"
MVN_BIN="$MAVEN_HOME/bin/mvn"

if [ ! -x "$MVN_BIN" ]; then
  echo "mvnw: Maven não encontrado no cache — baixando $DISTRIBUTION_URL"
  mkdir -p "$DIST_DIR"
  ZIP_PATH="$DIST_BASE/$ZIP_NAME"
  if command -v curl >/dev/null 2>&1; then
    curl -fL --silent --show-error -o "$ZIP_PATH" "$DISTRIBUTION_URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$ZIP_PATH" "$DISTRIBUTION_URL"
  else
    echo "mvnw: é necessário curl ou wget para baixar o Maven" >&2
    exit 1
  fi
  if ! command -v unzip >/dev/null 2>&1; then
    echo "mvnw: é necessário unzip para extrair o Maven" >&2
    exit 1
  fi
  unzip -q "$ZIP_PATH" -d "$DIST_DIR"
  rm -f "$ZIP_PATH"
  MAVEN_HOME="$DIST_DIR/$(ls "$DIST_DIR" | head -n1)"
  MVN_BIN="$MAVEN_HOME/bin/mvn"
fi

if [ ! -x "$MVN_BIN" ]; then
  echo "mvnw: não foi possível localizar o binário mvn em $MAVEN_HOME" >&2
  exit 1
fi

exec "$MVN_BIN" "$@"
